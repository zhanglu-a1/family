# 复制为 .env 后按需修改；.env 不要提交到仓库

# 数据库
DB_HOST=localhost
# 本机 3306 被占用时可改为 3307
DB_PORT=3306
DB_NAME=family_memoir
DB_USER=root
DB_PASSWORD=root123456

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT：生产环境必须替换，长度至少 32 字节
JWT_SECRET=family-memoir-default-secret-please-override-in-production

# 阿里云 OSS（Bucket 需设置为私有读）
OSS_ENABLED=false
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_DIR_PREFIX=family-memoir/
